# Multi-hop traversal query family. GSQL vertex sets returned by `SELECT ... FROM setName:s
# -(EdgeType:e)-> VertexType:t` are deduplicated by vertex id (matching Cypher's
# `RETURN DISTINCT n.id` semantics used throughout this family in queries_repository.rs).

CREATE OR REPLACE QUERY aggregate_expansion_1(VERTEX<User> id) FOR GRAPH benchmark_graph {
  Start = {id};
  Result = SELECT t FROM Start:s -(Friend:e)-> User:t;
  PRINT Result;
}

CREATE OR REPLACE QUERY aggregate_expansion_1_with_filter(VERTEX<User> id) FOR GRAPH benchmark_graph {
  Start = {id};
  Result = SELECT t FROM Start:s -(Friend:e)-> User:t WHERE t.age >= 18;
  PRINT Result;
}

CREATE OR REPLACE QUERY aggregate_expansion_2(VERTEX<User> id) FOR GRAPH benchmark_graph {
  Start = {id};
  Hop1 = SELECT t FROM Start:s -(Friend:e)-> User:t;
  Result = SELECT t FROM Hop1:s -(Friend:e)-> User:t;
  PRINT Result;
}

CREATE OR REPLACE QUERY aggregate_expansion_2_with_filter(VERTEX<User> id) FOR GRAPH benchmark_graph {
  Start = {id};
  Hop1 = SELECT t FROM Start:s -(Friend:e)-> User:t;
  Result = SELECT t FROM Hop1:s -(Friend:e)-> User:t WHERE t.age >= 18;
  PRINT Result;
}

CREATE OR REPLACE QUERY aggregate_expansion_3(VERTEX<User> id) FOR GRAPH benchmark_graph {
  Start = {id};
  Hop1 = SELECT t FROM Start:s -(Friend:e)-> User:t;
  Hop2 = SELECT t FROM Hop1:s -(Friend:e)-> User:t;
  Result = SELECT t FROM Hop2:s -(Friend:e)-> User:t;
  PRINT Result;
}

CREATE OR REPLACE QUERY aggregate_expansion_3_with_filter(VERTEX<User> id) FOR GRAPH benchmark_graph {
  Start = {id};
  Hop1 = SELECT t FROM Start:s -(Friend:e)-> User:t;
  Hop2 = SELECT t FROM Hop1:s -(Friend:e)-> User:t;
  Result = SELECT t FROM Hop2:s -(Friend:e)-> User:t WHERE t.age >= 18;
  PRINT Result;
}

CREATE OR REPLACE QUERY aggregate_expansion_4(VERTEX<User> id) FOR GRAPH benchmark_graph {
  Start = {id};
  Hop1 = SELECT t FROM Start:s -(Friend:e)-> User:t;
  Hop2 = SELECT t FROM Hop1:s -(Friend:e)-> User:t;
  Hop3 = SELECT t FROM Hop2:s -(Friend:e)-> User:t;
  Result = SELECT t FROM Hop3:s -(Friend:e)-> User:t;
  PRINT Result;
}

CREATE OR REPLACE QUERY aggregate_expansion_4_with_filter(VERTEX<User> id) FOR GRAPH benchmark_graph {
  Start = {id};
  Hop1 = SELECT t FROM Start:s -(Friend:e)-> User:t;
  Hop2 = SELECT t FROM Hop1:s -(Friend:e)-> User:t;
  Hop3 = SELECT t FROM Hop2:s -(Friend:e)-> User:t;
  Result = SELECT t FROM Hop3:s -(Friend:e)-> User:t WHERE t.age >= 18;
  PRINT Result;
}

# Same shape as `aggregate_expansion_2`/`_with_filter`; installed separately to line up 1:1 with
# the `neighbours_2*` family.
CREATE OR REPLACE QUERY neighbours_2(VERTEX<User> id) FOR GRAPH benchmark_graph {
  Start = {id};
  Hop1 = SELECT t FROM Start:s -(Friend:e)-> User:t;
  Result = SELECT t FROM Hop1:s -(Friend:e)-> User:t;
  PRINT Result;
}

CREATE OR REPLACE QUERY neighbours_2_with_filter(VERTEX<User> id) FOR GRAPH benchmark_graph {
  Start = {id};
  Hop1 = SELECT t FROM Start:s -(Friend:e)-> User:t;
  Result = SELECT t FROM Hop1:s -(Friend:e)-> User:t WHERE t.age >= 18;
  PRINT Result;
}

# `PRINT` always serializes full vertex attributes, so "with_data" is naturally the same query as
# the plain id-returning version; kept separate purely for catalog/name parity.
CREATE OR REPLACE QUERY neighbours_2_with_data(VERTEX<User> id) FOR GRAPH benchmark_graph {
  Start = {id};
  Hop1 = SELECT t FROM Start:s -(Friend:e)-> User:t;
  Result = SELECT t FROM Hop1:s -(Friend:e)-> User:t;
  PRINT Result;
}

CREATE OR REPLACE QUERY neighbours_2_with_data_and_filter(VERTEX<User> id) FOR GRAPH benchmark_graph {
  Start = {id};
  Hop1 = SELECT t FROM Start:s -(Friend:e)-> User:t;
  Result = SELECT t FROM Hop1:s -(Friend:e)-> User:t WHERE t.age >= 18;
  PRINT Result;
}

CREATE OR REPLACE QUERY pattern_short(VERTEX<User> id) FOR GRAPH benchmark_graph {
  Start = {id};
  Hop1 = SELECT t FROM Start:s -(Friend:e1)-> User:t;
  Result = SELECT t FROM Hop1:s -(Friend:e2)-> User:t;
  PRINT Result;
}

CREATE OR REPLACE QUERY pattern_long(VERTEX<User> id) FOR GRAPH benchmark_graph {
  Start = {id};
  Hop1 = SELECT t FROM Start:s -(Friend:e1)-> User:t;
  Hop2 = SELECT t FROM Hop1:s -(Friend:e2)-> User:t;
  Hop3 = SELECT t FROM Hop2:s -(Friend:e3)-> User:t;
  Result = SELECT t FROM Hop3:s -(Friend:e4)-> User:t;
  PRINT Result;
}

# 1..2 hop union, mirroring Cypher's `-[*1..2]->` variable-length expansion.
CREATE OR REPLACE QUERY var_len_friends(VERTEX<User> id) FOR GRAPH benchmark_graph {
  Start = {id};
  Hop1 = SELECT t FROM Start:s -(Friend:e)-> User:t;
  Hop2 = SELECT t FROM Hop1:s -(Friend:e)-> User:t;
  Result = Hop1 UNION Hop2;
  PRINT Result;
}

# Mirrors Cypher's `OPTIONAL MATCH`: the anchor is always printed even when it has no outgoing
# `Friend` edges (the `Friends` set is simply empty in that case).
CREATE OR REPLACE QUERY optional_friend(VERTEX<User> id) FOR GRAPH benchmark_graph {
  Start = {id};
  Friends = SELECT t FROM Start:s -(Friend:e)-> User:t;
  PRINT Start, Friends;
}

# Same traversal shape as `aggregate_expansion_1`; approximates Cypher's correlated
# `CALL { WITH a ... } RETURN bid` subquery.
CREATE OR REPLACE QUERY call_subquery(VERTEX<User> id) FOR GRAPH benchmark_graph {
  Start = {id};
  Result = SELECT t FROM Start:s -(Friend:e)-> User:t;
  PRINT Result;
}

# Bounded 1..3 hop traversal filtered on the edge's `bench_capacity`, counting the deduplicated
# union of all reachable vertices across the three hops (mirrors `count(t)` over a variable-length
# edge-filtered expansion).
CREATE OR REPLACE QUERY var_len_with_edge_where_filter(VERTEX<User> id, INT min_capacity) FOR GRAPH benchmark_graph {
  Start = {id};
  Hop1 = SELECT t FROM Start:s -(Friend:e)-> User:t WHERE e.bench_capacity >= min_capacity;
  Hop2 = SELECT t FROM Hop1:s -(Friend:e)-> User:t WHERE e.bench_capacity >= min_capacity;
  Hop3 = SELECT t FROM Hop2:s -(Friend:e)-> User:t WHERE e.bench_capacity >= min_capacity;
  AllHops = Hop1 UNION Hop2 UNION Hop3;
  PRINT AllHops.size() AS cnt;
}

# Exact-depth hop counts. Unlike the `_expansion_N`/`neighbours_*` families (which report
# deduplicated destination vertices), these count matching traversal paths at the accumulation
# step, before the final hop's output vertex set dedupes — matching Cypher's non-distinct
# `count(t)` over `-[:Friend*5..5]->`.
CREATE OR REPLACE QUERY exact_5_hop_traverse_count(VERTEX<User> id) FOR GRAPH benchmark_graph {
  SumAccum<INT> @@cnt = 0;
  Start = {id};
  H1 = SELECT t FROM Start:s -(Friend:e)-> User:t;
  H2 = SELECT t FROM H1:s -(Friend:e)-> User:t;
  H3 = SELECT t FROM H2:s -(Friend:e)-> User:t;
  H4 = SELECT t FROM H3:s -(Friend:e)-> User:t;
  H5 = SELECT t FROM H4:s -(Friend:e)-> User:t ACCUM @@cnt += 1;
  PRINT @@cnt AS cnt;
}

CREATE OR REPLACE QUERY exact_6_hop_traverse_count(VERTEX<User> id) FOR GRAPH benchmark_graph {
  SumAccum<INT> @@cnt = 0;
  Start = {id};
  H1 = SELECT t FROM Start:s -(Friend:e)-> User:t;
  H2 = SELECT t FROM H1:s -(Friend:e)-> User:t;
  H3 = SELECT t FROM H2:s -(Friend:e)-> User:t;
  H4 = SELECT t FROM H3:s -(Friend:e)-> User:t;
  H5 = SELECT t FROM H4:s -(Friend:e)-> User:t;
  H6 = SELECT t FROM H5:s -(Friend:e)-> User:t ACCUM @@cnt += 1;
  PRINT @@cnt AS cnt;
}
